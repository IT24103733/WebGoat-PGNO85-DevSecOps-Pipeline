<mxfile host="app.diagrams.net">
  <diagram id="arch2" name="Architecture v2">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="WebGoat DevSecOps Pipeline (PGNO 85) - Architecture Diagram" style="text;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- Trust boundaries and containers (drawn first so they sit behind) -->
        <mxCell id="b1" value="TRUST BOUNDARY 1&#xa;Public / Untrusted Zone" style="rounded=0;dashed=1;dashPattern=8 4;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="170" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="TRUST BOUNDARY 2 - Docker Host (docker compose)&#xa;bridge network: interconnect" style="rounded=0;dashed=1;dashPattern=8 4;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="580" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="WebGoat container (built from Dockerfile)" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="300" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="TRUST BOUNDARY 3 - Data Layer" style="rounded=0;dashed=1;dashPattern=8 4;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="520" y="275" width="260" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="TRUST BOUNDARY 4 - GitHub (Cloud) CI/CD" style="rounded=0;dashed=1;dashPattern=8 4;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="800" height="280" as="geometry"/>
        </mxCell>

        <!-- Runtime components -->
        <mxCell id="browser" value="User Browser&#xa;(Student / Attacker)" style="rounded=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="nginx" value="nginx&#xa;(reverse proxy)&#xa;Port 80" style="rounded=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="275" y="175" width="110" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="webwolf" value="WebWolf (attacker helper)&#xa;Port 9090" style="rounded=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="525" y="120" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="webgoat" value="WebGoat (Java / Spring Boot)&#xa;Port 8080" style="rounded=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="525" y="205" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="HSQLDB&#xa;(embedded database)" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="575" y="303" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- CI/CD components -->
        <mxCell id="dev" value="Developer&#xa;(team member)" style="rounded=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="510" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="repo" value="GitHub Repository&#xa;main, Core-Pipeline-**" style="rounded=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="510" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="job" value="GitHub Actions job: build-and-scan&#xa;1. Checkout code&#xa;2. Setup JDK 25&#xa;3. mvnw build (skip tests)&#xa;4. docker build&#xa;5. Trivy scan (fails on HIGH / CRITICAL)" style="rounded=1;fillColor=#ffffff;strokeColor=#000000;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="270" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="planned" value="PLANNED gates&#xa;Semgrep (SAST)&#xa;SCA scan&#xa;Gitleaks (secrets)&#xa;OWASP ZAP (optional)" style="rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="695" y="470" width="120" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="secrets" value="GitHub Encrypted Secrets (planned)" style="rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="640" width="270" height="40" as="geometry"/>
        </mxCell>

        <!-- Runtime data flows -->
        <mxCell id="e1" value="1. HTTP :80" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="browser" target="nginx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2. DIRECT access :8080 / :9090 (bypasses nginx)" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="browser" target="c1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="115" y="345"/>
              <mxPoint x="480" y="345"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="3. proxy" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="nginx" target="webgoat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="4. SQL (JDBC)" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="webgoat" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="5. callbacks" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="webgoat" target="webwolf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CI/CD data flows -->
        <mxCell id="e6" value="6. git push /&#xa;pull request" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="dev" target="repo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="7. triggers" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="repo" target="job">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="8. git pull +&#xa;docker compose up" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="repo" target="b2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="275" y="440"/>
              <mxPoint x="275" y="410"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="9. inject (planned)" style="endArrow=classic;html=1;dashed=1;strokeWidth=2;" edge="1" parent="1" source="secrets" target="job">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
